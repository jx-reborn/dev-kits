#pragma once

#include <cstdlib>
#include <new>
#include <utility>

namespace std {

template <class T>
class vector {
public:
    using iterator = T*;
    using const_iterator = const T*;

    vector() noexcept = default;

    vector(const vector& other) {
        if (other.size_ > 0) {
            reserve(other.size_);
            for (size_t i = 0; i < other.size_; ++i) {
                new (data_ + i) T(other.data_[i]);
            }
            size_ = other.size_;
        }
    }

    vector(vector&& other) noexcept
        : data_(other.data_), size_(other.size_), cap_(other.cap_) {
        other.data_ = nullptr;
        other.size_ = 0;
        other.cap_ = 0;
    }

    ~vector() {
        clear();
        if (data_) {
            std::free(data_);
        }
    }

    vector& operator=(const vector& other) {
        if (this != &other) {
            clear();
            if (other.size_ > 0) {
                reserve(other.size_);
                for (size_t i = 0; i < other.size_; ++i) {
                    new (data_ + i) T(other.data_[i]);
                }
                size_ = other.size_;
            }
        }
        return *this;
    }

    vector& operator=(vector&& other) noexcept {
        if (this != &other) {
            clear();
            if (data_) std::free(data_);
            data_ = other.data_;
            size_ = other.size_;
            cap_ = other.cap_;
            other.data_ = nullptr;
            other.size_ = 0;
            other.cap_ = 0;
        }
        return *this;
    }

    size_t size() const noexcept { return size_; }
    bool empty() const noexcept { return size_ == 0; }
    T* data() noexcept { return data_; }
    const T* data() const noexcept { return data_; }

    iterator begin() noexcept { return data_; }
    iterator end() noexcept { return data_ + size_; }
    const_iterator begin() const noexcept { return data_; }
    const_iterator end() const noexcept { return data_ + size_; }

    T& operator[](size_t i) noexcept { return data_[i]; }
    const T& operator[](size_t i) const noexcept { return data_[i]; }
    T& front() noexcept { return data_[0]; }
    const T& front() const noexcept { return data_[0]; }

    void clear() noexcept {
        for (size_t i = size_; i > 0; --i) {
            data_[i - 1].~T();
        }
        size_ = 0;
    }

    void reserve(size_t newCap) {
        if (newCap <= cap_) return;
        size_t allocCap = cap_ == 0 ? 8 : cap_;
        while (allocCap < newCap) {
            allocCap *= 2;
        }
        T* next = static_cast<T*>(std::malloc(allocCap * sizeof(T)));
        if (!next) return;
        for (size_t i = 0; i < size_; ++i) {
            new (next + i) T(move(data_[i]));
            data_[i].~T();
        }
        if (data_) std::free(data_);
        data_ = next;
        cap_ = allocCap;
    }

    void push_back(const T& val) {
        reserve(size_ + 1);
        new (data_ + size_) T(val);
        ++size_;
    }

    void push_back(T&& val) {
        reserve(size_ + 1);
        new (data_ + size_) T(move(val));
        ++size_;
    }

    iterator erase(iterator pos) {
        if (!pos || pos < begin() || pos >= end()) return end();
        size_t idx = static_cast<size_t>(pos - begin());
        for (size_t i = idx; i + 1 < size_; ++i) {
            data_[i] = move(data_[i + 1]);
        }
        data_[--size_].~T();
        return begin() + idx;
    }

private:
    T* data_ = nullptr;
    size_t size_ = 0;
    size_t cap_ = 0;
};

} // namespace std
