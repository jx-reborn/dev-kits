#pragma once

#include <cstdint>
#include <intrin.h>

namespace std {

enum memory_order {
    memory_order_relaxed,
    memory_order_consume,
    memory_order_acquire,
    memory_order_release,
    memory_order_acq_rel,
    memory_order_seq_cst
};

template <class T>
class atomic {
public:
    constexpr atomic() noexcept : val_(0) {}
    constexpr atomic(T desired) noexcept : val_(static_cast<long>(desired)) {}
    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;

    T load(memory_order = memory_order_seq_cst) const noexcept {
        _ReadWriteBarrier();
        long cur = _InterlockedCompareExchange(const_cast<long volatile*>(&val_), 0, 0);
        return static_cast<T>(cur);
    }

    void store(T desired, memory_order = memory_order_seq_cst) noexcept {
        _InterlockedExchange(&val_, static_cast<long>(desired));
    }

    T fetch_add(T arg, memory_order = memory_order_seq_cst) noexcept {
        long prev = _InterlockedExchangeAdd(&val_, static_cast<long>(arg));
        return static_cast<T>(prev);
    }

    bool compare_exchange_strong(T& expected, T desired, memory_order = memory_order_seq_cst) noexcept {
        long expLong = static_cast<long>(expected);
        long prev = _InterlockedCompareExchange(&val_, static_cast<long>(desired), expLong);
        if (prev == expLong) {
            return true;
        }
        expected = static_cast<T>(prev);
        return false;
    }

private:
    volatile long val_;
};

} // namespace std
