#pragma once

#include <utility>
#include <vector>

namespace std {

template <class T>
class deque {
public:
    using iterator = typename vector<T>::iterator;
    using const_iterator = typename vector<T>::const_iterator;

    bool empty() const noexcept { return vec_.empty(); }
    size_t size() const noexcept { return vec_.size(); }

    T& front() noexcept { return vec_.front(); }
    const T& front() const noexcept { return vec_.front(); }

    void push_back(const T& val) { vec_.push_back(val); }
    void push_back(T&& val) { vec_.push_back(move(val)); }

    void pop_front() {
        if (!vec_.empty()) {
            vec_.erase(vec_.begin());
        }
    }

    iterator begin() noexcept { return vec_.begin(); }
    iterator end() noexcept { return vec_.end(); }
    const_iterator begin() const noexcept { return vec_.begin(); }
    const_iterator end() const noexcept { return vec_.end(); }

    iterator erase(iterator pos) { return vec_.erase(pos); }

private:
    vector<T> vec_;
};

} // namespace std
